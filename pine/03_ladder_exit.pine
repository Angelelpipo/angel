//@version=6
//══════════════════════════════════════════════════════════════════════════════
//  MANIPULATOR ENGINE · MÓDULO 03 — ESCALERA (STEP TRAILING STOP)
//══════════════════════════════════════════════════════════════════════════════
//  La mecánica, tal cual:
//
//      Entrada 100 · SL 95 · TP1 105 · TP2 110 · TP3 115 · TP4 120
//
//      alcanza TP1  →  SL sube a 100  (la entrada)
//      alcanza TP2  →  SL sube a 105  (el antiguo TP1)
//      alcanza TP3  →  SL sube a 110  (el antiguo TP2)
//      alcanza TP4  →  SL sube a 115  (el antiguo TP3)
//
//  Regla general:  al conquistar el peldaño k, el SL pasa al peldaño k-2,
//                  siendo el peldaño 0 la propia entrada.
//
//  Por qué encaja con esta estrategia:
//    Un trailing continuo te saca en el primer retroceso — y el retroceso es
//    exactamente lo que provoca quien maneja el gráfico. La escalera solo se
//    mueve cuando el precio ha CONQUISTADO un nivel, no cuando se le acerca.
//    El piso sube por conquista, no por proximidad. Eso la hace inmune a las
//    sacudidas de diseño y compatible con dejar correr un tramo largo hasta el
//    siguiente depósito de liquidez.
//
//  Con el modo por defecto (múltiplos de R, espaciado 1.0), una entrada en 100
//  con stop en 95 reproduce el ejemplo de arriba exactamente.
//══════════════════════════════════════════════════════════════════════════════

strategy("Manipulator Engine 03 · Escalera", "ME·LADDER", overlay = true,
     initial_capital    = 10000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 100,
     pyramiding         = 0,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.05,
     slippage           = 2,
     calc_on_every_tick = false,
     max_lines_count    = 200,
     max_labels_count   = 200)

//──────────────────────────────────── ENTRADAS ────────────────────────────────
var string GR = "1 · Riesgo inicial"
slMode = input.string("Volatilidad", "Cómo se fija el stop inicial", options = ["Volatilidad", "Porcentaje"], group = GR)
slMult = input.float(1.5, "Stop = N × volatilidad", minval = 0.1,  step = 0.1,  group = GR)
slPct  = input.float(1.5, "Stop = N % del precio",  minval = 0.05, step = 0.05, group = GR)
volLen = input.int(48, "Barras para la unidad de volatilidad", minval = 5, group = GR)

var string GL = "2 · Escalera"
nRungs  = input.int(4, "Número de peldaños (TPs)", minval = 2, maxval = 6, group = GL)
tpMode  = input.string("Múltiplos de R", "Cómo se colocan los peldaños",
     options = ["Múltiplos de R", "Porcentaje", "Precios manuales", "Pools de liquidez"], group = GL,
     tooltip = "Múltiplos de R usa el riesgo inicial como unidad: 1R, 2R, 3R… 'Pools de liquidez' coloca cada peldaño en el siguiente depósito de stops, que es el destino real al que viaja el precio.")
rStep   = input.float(1.0, "Espaciado en R", minval = 0.1,  step = 0.1,  group = GL)
pctStep = input.float(1.0, "Espaciado en %", minval = 0.05, step = 0.05, group = GL)
exitFin = input.bool(true, "Cerrar en el último peldaño", group = GL,
     tooltip = "Desactivado, la escalera sigue subiendo indefinidamente con el mismo espaciado y el trade solo termina cuando el precio pierde el piso.")
partPct = input.float(0.0, "Cerrar % de la posición en cada peldaño", minval = 0, maxval = 90, step = 5, group = GL,
     tooltip = "0 = la posición entera corre hasta el final; solo sube el piso.")
consInt = input.bool(true, "Modo intrabarra conservador", group = GL,
     tooltip = "Activado, un peldaño conquistado solo eleva el SL a partir de la barra siguiente. Pine no sabe si dentro de una barra ocurrió antes el máximo o el mínimo; esta opción asume siempre lo peor. Desactivarlo infla el backtest.")

var string GM = "3 · Peldaños manuales"
m1 = input.float(0, "TP1", group = GM)
m2 = input.float(0, "TP2", group = GM)
m3 = input.float(0, "TP3", group = GM)
m4 = input.float(0, "TP4", group = GM)
m5 = input.float(0, "TP5", group = GM)
m6 = input.float(0, "TP6", group = GM)

var string GP = "4 · Pools de liquidez"
swingLen = input.int(5, "Fuerza del swing", minval = 1, maxval = 50, group = GP)
poolTol  = input.float(0.35, "Tolerancia de cluster (× volatilidad)", minval = 0.01, step = 0.05, group = GP)
minGap   = input.float(0.5,  "Separación mínima entre peldaños (× R)", minval = 0.1, step = 0.1, group = GP)

var string GE = "5 · Señal de entrada (provisional)"
// El motor de señal real es el módulo 04. Esto es un disparador mínimo, en la
// misma lógica de la estrategia, para que la escalera se pueda backtestear y
// auditar por sí sola. NO es la estrategia.
sigOn  = input.bool(true, "Usar señal provisional de barrido", group = GE)
sigN   = input.int(20, "Barras que definen el extremo a barrer", minval = 3, group = GE)
allowL = input.bool(true, "Permitir largos", group = GE)
allowS = input.bool(true, "Permitir cortos", group = GE)

var string GV = "6 · Visual"
showLad = input.bool(true, "Dibujar la escalera", group = GV)
showPnl = input.bool(true, "Panel del trade",     group = GV)

//──────────────────────── UNIDAD DE VOLATILIDAD (propia) ──────────────────────
float trueRange = na(close[1]) ? high - low
     : math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
float volUnit = math.max(math.sum(trueRange, volLen) / volLen, syminfo.mintick)

//────────────────── SWINGS PARA EL MODO 'POOLS DE LIQUIDEZ' ───────────────────
isSwingHigh(int L) =>
    bool ok = true
    float p = high[L]
    if na(p)
        ok := false
    else
        for i = 0 to 2 * L
            if i != L and high[i] > p
                ok := false
                break
    ok

isSwingLow(int L) =>
    bool ok = true
    float p = low[L]
    if na(p)
        ok := false
    else
        for i = 0 to 2 * L
            if i != L and low[i] < p
                ok := false
                break
    ok

var array<float> swHi = array.new<float>()
var array<float> swLo = array.new<float>()

pushLevel(array<float> arr, float px) =>
    float tol = volUnit * poolTol
    bool merged = false
    int  n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            if math.abs(array.get(arr, i) - px) <= tol
                merged := true
                break
    if not merged
        array.push(arr, px)
        if array.size(arr) > 300
            array.shift(arr)

if barstate.isconfirmed
    if isSwingHigh(swingLen)
        pushLevel(swHi, high[swingLen])
    if isSwingLow(swingLen)
        pushLevel(swLo, low[swingLen])

//══════════════════════════════════════════════════════════════════════════════
//  ESTADO DE LA ESCALERA
//══════════════════════════════════════════════════════════════════════════════
var float entryPx = na       // precio de entrada
var float baseSL  = na       // stop inicial
var float rUnit   = na       // riesgo inicial en precio = 1R
var int   dir     = 0        // +1 largo | -1 corto
var int   rung    = 0        // peldaños conquistados
var array<float> tps = array.new<float>()

// SL vigente según la escalera. Esta es LA regla, en una línea:
//   peldaño 0 → stop inicial · peldaño 1 → la entrada · peldaño k → TP(k-2)
ladderStop() =>
    float s = baseSL
    if rung == 1
        s := entryPx
    else if rung >= 2
        int idx = rung - 2
        int n   = array.size(tps)
        s := idx < n ? array.get(tps, idx)
             // Escalera infinita: pasado el último TP definido, el peldaño se
             // extrapola con el mismo espaciado.
             : n > 0 ? array.get(tps, n - 1) + dir * rUnit * rStep * (idx - n + 1) : baseSL
    s

// El siguiente objetivo por conquistar.
nextTarget() =>
    float t = na
    int   n = array.size(tps)
    if rung < n
        t := array.get(tps, rung)
    else if not exitFin and n > 0
        t := array.get(tps, n - 1) + dir * rUnit * rStep * (rung - n + 1)
    t

//───────────────────── CONSTRUCCIÓN DE LOS PELDAÑOS ───────────────────────────
buildTargets(float ep, float risk, int d) =>
    array<float> out = array.new<float>()

    if tpMode == "Múltiplos de R"
        for k = 1 to nRungs
            array.push(out, ep + d * risk * rStep * k)

    else if tpMode == "Porcentaje"
        for k = 1 to nRungs
            array.push(out, ep * (1 + d * pctStep / 100.0 * k))

    else if tpMode == "Precios manuales"
        array<float> man = array.from(m1, m2, m3, m4, m5, m6)
        for k = 0 to nRungs - 1
            float v = array.get(man, k)
            if v > 0
                array.push(out, v)

    else
        // POOLS DE LIQUIDEZ — el peldaño no es un múltiplo arbitrario: es el
        // siguiente sitio donde hay stops que cobrar. El objetivo pasa a tener
        // una razón de existir en vez de ser un número bonito.
        array<float> src  = d > 0 ? swHi : swLo
        array<float> cand = array.new<float>()
        int ns = array.size(src)
        if ns > 0
            for i = 0 to ns - 1
                float lv = array.get(src, i)
                if d > 0 ? lv > ep + risk * minGap : lv < ep - risk * minGap
                    array.push(cand, lv)

        // Se conquistan en orden de cercanía a la entrada.
        while array.size(cand) > 0 and array.size(out) < nRungs
            int   bi = 0
            float bv = array.get(cand, 0)
            int   nc = array.size(cand)
            if nc > 1
                for i = 1 to nc - 1
                    float v = array.get(cand, i)
                    if d > 0 ? v < bv : v > bv
                        bv := v
                        bi := i
            float last = array.size(out) == 0 ? ep : array.get(out, array.size(out) - 1)
            if math.abs(bv - last) >= risk * minGap
                array.push(out, bv)
            array.remove(cand, bi)

        // Sin suficientes pools se completa con múltiplos de R, para no dejar
        // la escalera coja.
        while array.size(out) < nRungs
            float last = array.size(out) == 0 ? ep : array.get(out, array.size(out) - 1)
            array.push(out, last + d * risk * rStep)

    out

//══════════════════════════════════════════════════════════════════════════════
//  SEÑAL PROVISIONAL — barrido y recuperación del extremo de N barras
//══════════════════════════════════════════════════════════════════════════════
float hhN = ta.highest(high, sigN)[1]
float llN = ta.lowest(low,   sigN)[1]
bool sweptHigh = not na(hhN) and high > hhN and close < hhN   // trampa arriba → corto
bool sweptLow  = not na(llN) and low  < llN and close > llN   // trampa abajo  → largo

bool goLong  = sigOn and allowL and sweptLow  and strategy.position_size == 0
bool goShort = sigOn and allowS and sweptHigh and strategy.position_size == 0

if goLong
    strategy.entry("L", strategy.long)
if goShort
    strategy.entry("S", strategy.short)

//══════════════════════════════════════════════════════════════════════════════
//  CICLO DE VIDA DEL TRADE
//══════════════════════════════════════════════════════════════════════════════
bool justOpened = strategy.position_size != 0 and nz(strategy.position_size[1], 0) == 0
bool inTrade    = strategy.position_size != 0
bool justClosed = strategy.position_size == 0 and nz(strategy.position_size[1], 0) != 0

if justOpened
    dir     := strategy.position_size > 0 ? 1 : -1
    entryPx := strategy.position_avg_price
    rUnit   := slMode == "Volatilidad" ? volUnit * slMult : entryPx * slPct / 100.0
    baseSL  := entryPx - dir * rUnit
    rung    := 0
    tps     := buildTargets(entryPx, rUnit, dir)

// ─── Avance de peldaños ───
// Un peldaño se conquista cuando el precio LO ALCANZA, no cuando se le acerca.
// En modo conservador se evalúa con los extremos de la barra ya cerrada: dentro
// de una barra Pine no sabe qué ocurrió primero, y asumir lo favorable es la
// forma más común de fabricar un backtest que no existe.
float probeHi = consInt ? nz(high[1], high) : high
float probeLo = consInt ? nz(low[1],  low)  : low

if inTrade and not justOpened
    bool advanced = true
    int  guard    = 0
    while advanced and guard < 50
        guard    += 1
        advanced := false
        float t = nextTarget()
        if not na(t)
            bool reached = dir > 0 ? probeHi >= t : probeLo <= t
            if reached and (rung < array.size(tps) or not exitFin)
                rung     += 1
                advanced := true
                if partPct > 0 and strategy.position_size != 0
                    strategy.close(dir > 0 ? "L" : "S", qty_percent = partPct, comment = "Peldaño " + str.tostring(rung))

float slNow = inTrade ? ladderStop() : na
float finTP = exitFin and array.size(tps) > 0 ? array.get(tps, array.size(tps) - 1) : na

if inTrade
    // Una única orden de salida con el piso vigente. El stop se reenvía cada
    // barra con el valor actualizado de la escalera.
    strategy.exit("SAL", from_entry = dir > 0 ? "L" : "S", stop = slNow, limit = finTP,
         comment_loss = "Piso perdido", comment_profit = "Último peldaño")

if justClosed
    dir     := 0
    rung    := 0
    entryPx := na
    baseSL  := na
    rUnit   := na
    array.clear(tps)

//══════════════════════════════════════════════════════════════════════════════
//  VISUALIZACIÓN
//══════════════════════════════════════════════════════════════════════════════
// El piso, dibujado como una escalera literal. Nunca baja mientras el trade
// vive: esa es toda la promesa de esta mecánica y conviene poder verificarla de
// un vistazo en vez de creérsela.
plot(inTrade ? slNow   : na, "Piso (SL)", color.new(#ef5350, 0),      2, plot.style_stepline)
plot(inTrade ? entryPx : na, "Entrada",   color.new(color.gray, 20),  1, plot.style_linebr)

var array<line>  ladLines = array.new<line>()
var array<label> ladLabs  = array.new<label>()

clearLadder() =>
    while array.size(ladLines) > 0
        line.delete(array.pop(ladLines))
    while array.size(ladLabs) > 0
        label.delete(array.pop(ladLabs))

if barstate.islast and showLad
    clearLadder()
    if inTrade
        int n = array.size(tps)
        if n > 0
            for k = 0 to n - 1
                float lv   = array.get(tps, k)
                bool  done = k < rung
                color c    = done ? color.new(#26a69a, 20) : color.new(#26a69a, 65)
                array.push(ladLines, line.new(bar_index - 40, lv, bar_index + 12, lv,
                     xloc = xloc.bar_index, color = c, width = done ? 2 : 1,
                     style = done ? line.style_solid : line.style_dashed))
                array.push(ladLabs, label.new(bar_index + 12, lv,
                     "TP" + str.tostring(k + 1) + (done ? " ✓" : "") + "  " + str.tostring(lv, format.mintick),
                     xloc = xloc.bar_index, style = label.style_label_left, size = size.tiny,
                     color = color.new(color.black, 100), textcolor = c))
        array.push(ladLabs, label.new(bar_index + 12, slNow, "PISO  " + str.tostring(slNow, format.mintick),
             xloc = xloc.bar_index, style = label.style_label_left, size = size.tiny,
             color = color.new(color.black, 100), textcolor = color.new(#ef5350, 0)))

//──────────────────────────── PANEL DEL TRADE ─────────────────────────────────
var table pnl = table.new(position.top_right, 2, 8,
     border_color = color.new(color.gray, 70), border_width = 1,
     frame_color = color.new(color.gray, 50), frame_width = 1)

prow(int r, string k, string v, color cv) =>
    table.cell(pnl, 0, r, k, text_size = size.small, text_color = color.new(color.gray, 10), text_halign = text.align_left,  bgcolor = color.new(color.black, 82))
    table.cell(pnl, 1, r, v, text_size = size.small, text_color = cv,                        text_halign = text.align_right, bgcolor = color.new(color.black, 82))

if barstate.islast and showPnl
    // Beneficio bloqueado: dónde está el piso respecto a la entrada. Positivo
    // significa que el trade ya no puede perder dinero pase lo que pase.
    float lockedR = inTrade and not na(rUnit) and rUnit > 0 ? (slNow - entryPx) * dir / rUnit : na
    color cLock   = na(lockedR) ? color.new(color.gray, 30) : lockedR > 0 ? #26a69a : lockedR == 0 ? #ffa726 : #ef5350
    float nt      = inTrade ? nextTarget() : na

    table.cell(pnl, 0, 0, "ESCALERA", text_size = size.small, text_color = color.white, text_halign = text.align_left,  bgcolor = color.new(color.blue, 55))
    table.cell(pnl, 1, 0, inTrade ? (dir > 0 ? "LARGO" : "CORTO") : "sin posición",
         text_size = size.small, text_color = color.white, text_halign = text.align_right, bgcolor = color.new(color.blue, 55))

    prow(1, "Entrada",   inTrade ? str.tostring(entryPx, format.mintick) : "—", color.new(color.gray, 10))
    prow(2, "Peldaño",   inTrade ? str.tostring(rung) + " / " + str.tostring(array.size(tps)) + (exitFin ? "" : "  ∞") : "—", color.new(color.gray, 10))
    prow(3, "Piso (SL)", inTrade ? str.tostring(slNow, format.mintick) : "—", #ef5350)
    prow(4, "Bloqueado", na(lockedR) ? "—" : (lockedR > 0 ? "+" : "") + str.tostring(lockedR, "#.##") + " R", cLock)
    prow(5, "Objetivo",  na(nt) ? "—" : str.tostring(nt, format.mintick), #26a69a)
    prow(6, "1R",        inTrade ? str.tostring(rUnit, format.mintick) : "—", color.new(color.gray, 10))
    prow(7, "Modo",      tpMode + (consInt ? "  ·cons" : ""), color.new(color.gray, 30))

//──────────────────────────────── ALERTAS ─────────────────────────────────────
bool rungUp = inTrade and rung > nz(rung[1], 0)
alertcondition(rungUp, "Peldaño conquistado", "La escalera subió un peldaño — el piso del trade ha subido")
